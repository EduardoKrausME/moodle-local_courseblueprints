<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/courseblueprints/db" VERSION="20261014" COMMENT="Course blueprints persistent state" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="local_courseblueprints_bp" COMMENT="Stable institutional blueprint identities">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="code" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="description" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="ownerid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="ownerid" TYPE="foreign" FIELDS="ownerid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="code" UNIQUE="true" FIELDS="code"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_courseblueprints_ver" COMMENT="Immutable published version data">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="blueprintid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="revision" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft"/>
        <FIELD NAME="authorid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sourcecourseid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="manifest" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="structure" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="contenthash" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="backuphash" TYPE="char" LENGTH="64" NOTNULL="false"/>
        <FIELD NAME="reviewed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="reviewerid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="reviewedat" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="reviewnotes" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="publishedat" TYPE="int" LENGTH="10" NOTNULL="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="blueprintid" TYPE="foreign" FIELDS="blueprintid" REFTABLE="local_courseblueprints_bp" REFFIELDS="id"/>
        <KEY NAME="authorid" TYPE="foreign" FIELDS="authorid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="blueprintrevision" UNIQUE="true" FIELDS="blueprintid,revision"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_courseblueprints_run" COMMENT="Batch request and its idempotency key">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="requestkey" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="requesthash" TYPE="char" LENGTH="64" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="versionid" TYPE="foreign" FIELDS="versionid" REFTABLE="local_courseblueprints_ver" REFFIELDS="id"/>
        <KEY NAME="userid" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="requestkey" UNIQUE="true" FIELDS="requestkey"/></INDEXES>
    </TABLE>
    <TABLE NAME="local_courseblueprints_itm" COMMENT="Individual course provisioning outcomes">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="runid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="rownum" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="categoryid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fullname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="shortname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="params" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="status" TYPE="char" LENGTH="25" NOTNULL="true" DEFAULT="queued"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errorcode" TYPE="char" LENGTH="100" NOTNULL="false"/>
        <FIELD NAME="errormessage" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="validation" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="runid" TYPE="foreign" FIELDS="runid" REFTABLE="local_courseblueprints_run" REFFIELDS="id"/>
        <KEY NAME="versionid" TYPE="foreign" FIELDS="versionid" REFTABLE="local_courseblueprints_ver" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="runrow" UNIQUE="true" FIELDS="runid,rownum"/>
        <INDEX NAME="courseid" UNIQUE="true" FIELDS="courseid"/>
        <INDEX NAME="status" UNIQUE="false" FIELDS="status"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_courseblueprints_map" COMMENT="Course links remain pinned to original blueprint revisions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="versionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="itemid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="baseline" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="versionid" TYPE="foreign" FIELDS="versionid" REFTABLE="local_courseblueprints_ver" REFFIELDS="id"/>
        <KEY NAME="itemid" TYPE="foreign" FIELDS="itemid" REFTABLE="local_courseblueprints_itm" REFFIELDS="id"/>
      </KEYS>
      <INDEXES><INDEX NAME="courseid" UNIQUE="true" FIELDS="courseid"/></INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
