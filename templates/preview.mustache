{{!
    @template local_courseblueprints/preview

    Institutional course blueprints preview view.

    Example context (json):
    {
        "title": "Provisioning preview",
        "hasissues": false,
        "issues": "",
        "fullname": "Full name",
        "shortname": "Short name",
        "category": "Category",
        "rows": [
            {
                "fullname": "Example course",
                "shortname": "EXAMPLE",
                "categoryid": 1,
                "startdate": "1 Jan 2026",
                "enddate": "1 Dec 2026"
            }
        ],
        "actionurl": "/local/courseblueprints/provision.php?step=3",
        "sesskey": "example",
        "nonce": "example",
        "confirm": "Confirm"
    }
}}
<div class="local-courseblueprints">
    <h2>{{title}}</h2>
    {{#hasissues}}<p class="alert alert-danger">{{issues}}</p>{{/hasissues}}
    <div class="table-responsive"><table class="table">
        <thead><tr><th>{{fullname}}</th><th>{{shortname}}</th><th>{{category}}</th><th>Start</th><th>End</th></tr></thead>
        <tbody>{{#rows}}<tr><td>{{fullname}}</td><td>{{shortname}}</td><td>{{categoryid}}</td><td>{{startdate}}</td><td>{{enddate}}</td></tr>{{/rows}}</tbody>
    </table></div>
    {{^hasissues}}<form method="post" action="{{{actionurl}}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="nonce" value="{{nonce}}">
        <button type="submit" name="action" value="confirm" class="btn btn-primary">{{confirm}}</button>
    </form>{{/hasissues}}
</div>
